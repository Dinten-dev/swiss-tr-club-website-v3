{
  "name": "swiss-tr-club/strc-core",
  "description": "Club-specific WordPress functionality for Swiss TR-Club.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "php-parallel-lint/php-parallel-lint": "^1.4",
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "SwissTRClub\\Core\\": "src/"
    }
  },
  "scripts": {
    "lint": "parallel-lint --exclude vendor .",
    "test": "phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
