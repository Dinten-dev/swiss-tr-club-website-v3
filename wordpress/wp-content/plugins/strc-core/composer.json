{
  "name": "swiss-tr-club/strc-core",
  "description": "Club-specific WordPress functionality for Swiss TR-Club.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.13"
  },
  "autoload": {
    "psr-4": {
      "SwissTRClub\\Core\\": "src/"
    }
  },
  "scripts": {
    "lint": "phpcs -n --standard=phpcs.xml.dist",
    "test": "phpunit --configuration=phpunit.xml.dist"
  },
  "config": {
    "sort-packages": true
  }
}
