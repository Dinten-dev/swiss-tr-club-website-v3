<?xml version="1.0"?>
<ruleset name="STRC Core">
    <description>Modern PHP coding standard for STRC Core.</description>
    <file>strc-core.php</file>
    <file>src</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg value="ps"/>
    <rule ref="PSR12"/>
</ruleset>
